# ==============================================================================
# AQUA CREW — Environment Configuration Reference Template (.env.example)
# Copy this file to .env and configure values for your environment.
# Note: In production, never commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
AQUA_API_TITLE="AQUA CREW Core API"
AQUA_API_DESCRIPTION="Autonomous Water Leakage Detection, Hydraulic Digital Twin & Fleet Management"
AQUA_API_VERSION="0.1.0"
# Set to 'production', 'staging', or 'development'
AQUA_API_ENV=development
AQUA_API_HOST=0.0.0.0
AQUA_API_PORT=8000
AQUA_API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
AQUA_LOG_LEVEL=INFO
# 'text' for colorized dev terminal, 'json' for structured production ELK/CloudWatch logging
AQUA_LOG_FORMAT=text

# ------------------------------------------------------------------------------
# 3. CORS ACCESS CONTROL
# ------------------------------------------------------------------------------
# In production, specify exact client origins. Wildcard '*' is strictly prohibited.
AQUA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Development: SQLite
AQUA_DATABASE_URL="sqlite:///./aqua_crew_dev.db"
# Production: PostgreSQL + PostGIS (example: postgresql://user:password@postgres-host:5432/aqua_crew)
# AQUA_DATABASE_URL="postgresql://aqua_admin:super_secure_db_password_here@localhost:5432/aqua_crew"

# ------------------------------------------------------------------------------
# 5. ZERO-TRUST IDENTITY, JWT & AUTHENTICATION (NIST SP 800-63B)
# ------------------------------------------------------------------------------
# In production, JWT_SECRET_KEY must be a cryptographically random string >= 32 characters
AQUA_JWT_SECRET_KEY="aqua-crew-dev-insecure-secret-key-32-chars-min"
AQUA_JWT_ALGORITHM=HS256
AQUA_ACCESS_TOKEN_EXPIRE_MINUTES=60
AQUA_REFRESH_TOKEN_EXPIRE_DAYS=7
AQUA_JWT_ISSUER="aqua-crew-auth"
AQUA_JWT_AUDIENCE="aqua-crew-api"
# Enforce authentication headers across all API endpoints (Mandatory in production)
AQUA_REQUIRE_AUTH=false

# Account lockout thresholds
AQUA_MAX_FAILED_LOGIN_ATTEMPTS=5
AQUA_ACCOUNT_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# 6. API RATE LIMITING & SECURITY MIDDLEWARES
# ------------------------------------------------------------------------------
AQUA_RATE_LIMIT_ENABLED=true
AQUA_RATE_LIMIT_DEFAULT=120
AQUA_RATE_LIMIT_AUTH=10

# ------------------------------------------------------------------------------
# 7. WEBSOCKET REAL-TIME TELEMETRY STREAM
# ------------------------------------------------------------------------------
AQUA_WS_HEARTBEAT_INTERVAL_SECONDS=15
AQUA_MAX_WS_CONNECTIONS=100
AQUA_MAX_WS_PER_IP=10

# ------------------------------------------------------------------------------
# 8. VIRTUAL SIMULATION ENGINE
# ------------------------------------------------------------------------------
# Simulation is purely virtual: Never connects to physical hardware or actuators
AQUA_SIMULATION_TICK_INTERVAL_MS=1000
AQUA_SIMULATION_AUTO_START=true

# ------------------------------------------------------------------------------
# 9. ADVANCED AI & LLM DECISION SUPPORT
# ------------------------------------------------------------------------------
# AI Provider: 'DETERMINISTIC' (zero-cost offline), 'NVIDIA_NIM', or 'OPENAI'
AQUA_AI_PROVIDER=DETERMINISTIC
AQUA_AI_MODEL=meta/llama-3.1-70b-instruct
# AQUA_AI_API_KEY=your_nvidia_nim_or_openai_api_key_here
# AQUA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
AQUA_AI_TIMEOUT=30.0
AQUA_AI_MAX_TOKENS=2048
AQUA_AI_TEMPERATURE=0.2
